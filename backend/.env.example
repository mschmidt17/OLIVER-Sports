# Puerto del servidor Express
PORT=4000

# Ruta del archivo SQLite (relativa a /backend). Lo genera npm run seed.
DB_PATH=data/oliver.db

# Proveedor de IA (por ahora solo "gemini")
AI_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_aca
GEMINI_MODEL=gemini-3.1-flash-lite

# Tiempo máximo de espera de la respuesta del modelo, en milisegundos
AI_TIMEOUT_MS=20000
